#!/usr/bin/env python3
"""
Simple analysis for prediction vs actual results.

CSV expected columns:
- predicted
- actual

Usage:
  pip install pandas scipy
  python predictions_analysis.py predictions.csv --p0 0.1
"""
import argparse
import sys
import pandas as pd
from scipy.stats import binomtest

def load_csv(path):
    df = pd.read_csv(path)
    if 'predicted' not in df.columns or 'actual' not in df.columns:
        raise ValueError("CSV must contain 'predicted' and 'actual' columns")
    return df

def main():
    p = argparse.ArgumentParser(description="Evaluate prediction accuracy vs random baseline")
    p.add_argument('csv', help='Path to CSV file with columns: predicted, actual')
    p.add_argument('--p0', type=float, default=None,
                   help='Baseline probability for a correct prediction (e.g. 0.1 for 1/10). If omitted, will try to infer for discrete labels.')
    p.add_argument('--min-samples', type=int, default=10, help='Warn if sample size is small')
    args = p.parse_args()

    try:
        df = load_csv(args.csv)
    except Exception as e:
        print("Error loading CSV:", e, file=sys.stderr)
        sys.exit(2)

    df = df.dropna(subset=['predicted', 'actual'])
    df['correct'] = df['predicted'].astype(str) == df['actual'].astype(str)
    n = len(df)
    k = int(df['correct'].sum())
    accuracy = k / n if n > 0 else 0.0

    # infer p0 if not provided: if labels numeric or categorical, assume uniform over distinct actual values
    p0 = args.p0
    if p0 is None:
        distinct = df['actual'].nunique()
        if distinct > 1:
            p0 = 1.0 / distinct
        else:
            p0 = 0.5  # fallback
    # run binomial test (one-sided: greater than random baseline)
    res = binomtest(k, n, p0, alternative='greater')

    print("Result summary")
    print("--------------")
    print(f"Total predictions: {n}")
    print(f"Correct predictions: {k}")
    print(f"Accuracy: {accuracy:.4f} ({accuracy*100:.2f}%)")
    print(f"Baseline p0 used: {p0}")
    print(f"Binomial test (greater): p-value = {res.pvalue:.6g}")
    print()

    if n < args.min_samples:
        print(f"Warning: small sample size (n={n}). Results may be unreliable.")
    print("Top predicted values (count):")
    print(df['predicted'].value_counts().head(10).to_string())
    print()
    print("Top actual values (count):")
    print(df['actual'].value_counts().head(10).to_string())
    print()
    print("If you want, save a detailed CSV of mismatches:")
    mismatches = df.loc[~df['correct'], ['predicted','actual']]
    print(f"Mismatches: {len(mismatches)} rows")
    # optionally write mismatches file:
    mismatches.to_csv('mismatches.csv', index=False)
    print("Wrote mismatches.csv containing the incorrect predictions (if any).")

if __name__ == '__main__':
    main()
